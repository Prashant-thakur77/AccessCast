        "words_max": {
          "title": "Words Max",
          "type": "integer"
        },
        "seconds_max": {
          "title": "Seconds Max",
          "type": "number"
        },
        "wps_voice": {
          "title": "Wps Voice",
          "type": "number"
        }
      },
      "required": [
        "words_max",
        "seconds_max",
        "wps_voice"
      ],
      "title": "Budget",
      "type": "object"
    },
    "FindingModel": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "observed": {
          "title": "Observed",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "owner_stage": {
          "title": "Owner Stage",
          "type": "string"
        },
        "repairable": {
          "default": true,
          "title": "Repairable",
          "type": "boolean"
