      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "sha12": {
      "title": "Sha12",
      "type": "string"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "duration_ms": {
      "title": "Duration Ms",
      "type": "integer"
    },
    "fps": {
      "title": "Fps",
      "type": "number"
    },
    "width": {
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "title": "Height",
      "type": "integer"
    },
    "has_audio": {
      "title": "Has Audio",
      "type": "boolean"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
