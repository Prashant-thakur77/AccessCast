{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.vtt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vtt; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/attack.py": {
      "maxDuration": 60,
      "includeFiles": "api/_vendor/**",
      "excludeFiles": "{p/**,assets/**,data/**,*.html,*.png,*.jpg,*.gif,*.mp4}"
    }
  }
}
